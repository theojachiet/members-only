<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Home</title>
</head>

<body>
    <p>Welcome to the page <%= currentUser ? currentUser.username : 'Guest' %>
    </p>
    <p>
        <%= currentUser.is_admin ? 'You only see this messsage if you are an admin' : '' %>
    </p>
    <a href="/profile">Your profile page</a>
    <form action="/logout" method="POST">
        <button type="submit">Logout</button>
    </form>
    <% if (messages.length===0) {%>
        <p>No messages to show</p>
        <%} else {%>
            <ul>
                <% messages.forEach(message=> {%>
                    <li>
                        <p>
                            <%= message.text %>
                        </p>
                        <p>
                            <% if (currentUser.is_admin) {%>
                                By <%= message.username %> at <%= message.date.toLocaleString() %>
                                        <%} else {%>
                                            At <%= message.date.toLocaleString() %>
                                        <%}%>
                        </p>
                        <% if (currentUser.is_admin) {%>
                            <p>
                            <form action="/<%= message.id %>/deleteMessage" method="POST"><button type="submit">Delete
                                    Message</button></form>
                            </p>
                            <%}%>
                    </li>
                    <%})}%>
            </ul>
            <a href="/createMessage">Write a message</a>
</body>

</html>